@startuml C3-Component-Diagram-Datos

/' Importar Paquetes '/
!include %getenv("PLANTUML_C4_HOME")/C4_Component.puml

/' Definir Iconos y Fuentes '/
!define DEVICONS %getenv("PLANTUML_ICON_FONT_SPRITES")/icons/devicons
!define FONTAWESOME %getenv("PLANTUML_ICON_FONT_SPRITES")/icons/font-awesome-5

left to right direction

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

Container(web_api_datos , "EthosPlatform API - Datos" , "Node.js" , "Contiene detalles técnicos como la base de datos, frameworks,\nherramientas y dispositivos.")
Container_Boundary(web_api_datos_boundary , "EthosPlatform API - Datos"){
    Component(connections , "Connections" , "Typescript" , "Define conexiones a bases de datos.")
    Component(repositories , "Repositories" , "Typescript Class" , "Permite abstraer el acceso a los registros de la base de datos.")
    Component(entities , "Entities" , "Typescript Class" , "Mapean tablas a código OO, registros a clases y columnas a campos de clases.")
    Component(mappers , "Mappers" , "Typescript Class" , "Clase con métodos estáticos encargado de transformar\nEntity -> DomainEntity.")
}
Container_Ext(web_api_application_ext , "EthosPlatform API - Application" , "Node.js" , "Contiene la lógica de negocio\nespecífica de la aplicación.\nCoordina el flujo de datos\nhacia y desde las entidades,\norquestando cómo se cumplen las reglas\nde negocio.")
Container_Ext(web_api_domain_ext , "EthosPlatform API - Domain" , "Node.js" , "Contiene las reglas de negocio\nempresariales criticas,\nobjetos del dominio\ny estructuras de datos centrales.")


web_api_datos .. web_api_datos_boundary

Rel(repositories , connections , "Usa")
Rel(repositories , mappers , "Usa")
Rel(mappers , entities , "Usa")

Rel(repositories , web_api_application_ext , "Implementa" , "IRepository")
Rel(mappers , web_api_domain_ext , "Usa" , "DomainEntities")

@enduml