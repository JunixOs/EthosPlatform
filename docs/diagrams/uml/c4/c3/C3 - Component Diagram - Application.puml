@startuml C3-Component-Diagram-Application

/' Importar Paquetes '/
!include %getenv("PLANTUML_C4_HOME")/C4_Component.puml

/' Definir Iconos y Fuentes '/
!define DEVICONS %getenv("PLANTUML_ICON_FONT_SPRITES")/icons/devicons
!define FONTAWESOME %getenv("PLANTUML_ICON_FONT_SPRITES")/icons/font-awesome-5

left to right direction

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

Container(web_api_application , "EthosPlatform API - Application" , "Node.js" , "Contiene la lógica de negocio\nespecífica de la aplicación.\nCoordina el flujo de datos\nhacia y desde las entidades,\norquestando cómo se cumplen las reglas\nde negocio.")
Container_Boundary(web_api_application_boundary , "EthosPlatform API - Application"){
    Component(i_use_case , "IUseCase" , "Typescript Interface" , "Interfaz que será implementada por UseCase y sera usada por Controllers en la capa de InterfaceAdapters.")

    Component(use_case , "UseCase" , "Typescript Class" , "Coordinan la lógica de negocio para una funcionalidad especifica.")
    Component(validator , "Validator" , "Typescript Class" , "Contiene validaciones para los datos de entrada a UseCase.")
    Component(command_dto , "Command DTO" , "Typescript Class" , "Mapea los datos de la request para ser usada por UseCase.")
    Component(output_dto , "Output DTO" , "Typescript Class" , "Mapea los datos para ser devueltos al Controller en la capa de InterfaceAdapters.")
    
    Component(i_repository , "IRepository" , "Typescript Interface" , "Interfaz que sera implementada por la capa de Datos.")
    Component(exceptions , "Exceptions" , "Typescript Class" , "Contiene excepciones personalizadas de la aplicación.")
}
Container_Ext(web_api_interface_adapters_ext , "EthosPlatform API - InterfaceAdapters" , "Node.js" , "Se encarga de recibir y responder a las peticiones del Frontend, se comunica con la capa Application")
Container_Ext(web_api_datos_ext , "EthosPlatform API - Datos" , "Node.js" , "Contiene detalles técnicos como la base de datos, frameworks,\nherramientas y dispositivos.")
Container_Ext(web_api_domain_ext , "EthosPlatform API - Domain" , "Node.js" , "Contiene las reglas de negocio\nempresariales criticas,\nobjetos del dominio\ny estructuras de datos centrales.")

web_api_application .. web_api_application_boundary

Rel_L(use_case , i_use_case , "Implementa")

Rel(use_case , validator , "Usa")

Rel(use_case , command_dto , "Usa")
Rel(use_case , output_dto , "Usa")

Rel(use_case , i_repository , "Usa")

Rel(use_case , exceptions , "Lanza")

Rel(web_api_interface_adapters_ext , i_use_case , "Usa")
Rel_U(web_api_datos_ext , i_repository , "Implementa")
Rel_R(use_case , web_api_domain_ext , "Usa" , "DomainEntity")

@enduml