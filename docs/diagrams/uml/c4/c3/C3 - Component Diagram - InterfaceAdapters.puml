@startuml C3-Component-Diagram-InterfaceAdapters

/' Importar Paquetes '/
!include %getenv("PLANTUML_C4_HOME")/C4_Component.puml

/' Definir Iconos y Fuentes '/
!define DEVICONS %getenv("PLANTUML_ICON_FONT_SPRITES")/icons/devicons
!define FONTAWESOME %getenv("PLANTUML_ICON_FONT_SPRITES")/icons/font-awesome-5

left to right direction

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

Container(web_api_interface_adapters , "EthosPlatform API - InterfaceAdapters" , "Node.js" , "Se encarga de recibir y responder a las peticiones del Frontend, se comunica con la capa Application")
Container_Boundary(web_api_interface_adapters_boundary , "EthosPlatform API - InterfaceAdapters"){
    Component(controller , "Controller" , "Node.js Controller" , "Endpoints REST para recibir peticiones HTTP y HTTPS.")

    Component(request_dto , "Request DTO" , "Typescript Class" , "Mapea los datos que envia el Frontend a la API como request.")
    Component(response_dto , "Response DTO" , "Typescript Class" , "Mapea los datos que se devolveran al Frontend como respuesta.")
    Component(mapper , "Mapper" , "Typescript Class" , "Clase con métodos estáticos encargado de transformar ResquestDTO -> ControllerDTO y OutputDTO -> ResponseDTO.")

    Component(middleware , "Middleware" , "Typescript Class" , "Es el primero en recibir la peticion del usuario, tiene como finalidad capturar excepciones de la aplicación.")
}
Container_Ext(web_api_application_ext , "EthosPlatform API - Application" , "Node.js" , "Contiene la lógica de negocio\nespecífica de la aplicación.\nCoordina el flujo de datos\nhacia y desde las entidades,\norquestando cómo se cumplen las reglas\nde negocio.")

web_api_interface_adapters .. web_api_interface_adapters_boundary

Rel(middleware , controller , "Continua Hacia")

Rel(controller , mapper , "Usa")

Rel(mapper , request_dto , "Usa")
Rel(mapper , response_dto , "Usa")

Rel_R(middleware , web_api_application_ext , "Captura" , "Exceptions")
Rel_R(mapper , web_api_application_ext , "Usa" , "CommandDTO , OutputDTO")
Rel_R(controller , web_api_application_ext , "Usa" , "IUseCase")

@enduml