@startuml C3-Component-Diagram
/' Importar Paquetes '/
!include %getenv("PLANTUML_C4_HOME")/C4_Component.puml

/' Definir Iconos y Fuentes '/
!define DEVICONS %getenv("PLANTUML_ICON_FONT_SPRITES")/icons/devicons
!define FONTAWESOME %getenv("PLANTUML_ICON_FONT_SPRITES")/icons/font-awesome-5

/' Definir Fuentes '/
!include FONTAWESOME/users.puml

!include DEVICONS/postgresql.puml
!include DEVICONS/nodejs.puml

left to right direction

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

Container(web_api , "EthosPlatform API" , "Node.js")
Container_Boundary(web_api_boundary , "EthosPlatform API"){

    Component(interface_adapters , "ExperiencesController" , "Node.js Controller" , "Endpoints REST.")

    Component(iapplication , "ICreateExperienceUseCase" , "Interface Application Service" , "Establece un contrato para acceso a UseCase.")
    Component(application , "CreateExperienceUseCase" , "Application Service" , "Implementa interfaz de UseCase y orquesta lógica de negocio.")

    Component(irepo , "IExperienceRepository" , "Interface Repository" , "Establece un contrato para acceso a datos.")

    Component(repo , "ExperienceRepository" , "Repository" , "Implementa interfaz de repositorio y brinda acceso a datos.")

    Component(entity , "ExperienceDomainEntity" , "Domain Entity" , "Entidad de dominio.")

}

web_api .. web_api_boundary

Rel(interface_adapters , iapplication , "Invoca")

Rel(application , iapplication , "Implementa")

Rel(application , irepo , "Invoca")

Rel(repo, irepo , "Implementa")

Rel(application , entity , "Manipula")

@enduml