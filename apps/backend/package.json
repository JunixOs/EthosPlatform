    "globals": "^17.6.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.3",
    "typeorm-ts-node-commonjs": "^0.3.20",
