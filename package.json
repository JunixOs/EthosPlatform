{
  "name": "ethos-platform-app",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r dev",
    "build": "pnpm -r build",
    "build:backend": "pnpm --filter @app/backend build",
    "build:frontend": "pnpm --filter @app/frontend build",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter @app/backend test",
    "test:frontend": "pnpm --filter @app/frontend test",
    "test:watch": "pnpm --filter @app/backend test:watch & pnpm --filter @app/frontend test:watch",
    "test:backend:watch": "pnpm --filter @app/backend test:watch",
    "test:frontend:watch": "pnpm --filter @app/frontend test:watch",
    "test:coverage": "pnpm --filter @app/backend test:coverage && pnpm --filter @app/frontend test:coverage",
    "test:backend:coverage": "pnpm --filter @app/backend test:coverage",
    "test:frontend:coverage": "pnpm --filter @app/frontend test:coverage",
    "lint": "pnpm --filter @app/backend lint && pnpm --filter @app/frontend lint",
    "db:seed": "pnpm --filter @app/backend db:seed",
    "e2e": "pnpm --filter @tests/e2e test",
    "e2e:ui": "pnpm --filter @tests/e2e test --ui",
    "e2e:report": "pnpm --filter @tests/e2e test --reporter=html",
    "sonar:scan": "sonar-scanner",
    "quality:check": "pnpm test:coverage && pnpm sonar:scan",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx}\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.8.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "prettier": "^3.9.5",
    "sonarqube-scanner": "^4.4.0"
  }
}
